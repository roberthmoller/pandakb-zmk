if SHIELD_GAME_BADGE

config PANDAKB_APP_LAYER
	default y

config PANDAKB_GAME_BADGE_SCREEN
	default y

config ZMK_DISPLAY
	default y

choice ZMK_DISPLAY_STATUS_SCREEN
	default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
	default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

endif # SHIELD_GAME_BADGE
