{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PandaKB",
  "version": "0.1.0",
  "identifier": "com.pandakb.companion",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "PandaKB — Flash",
        "width": 920,
        "height": 820,
        "resizable": true,
        "visible": true
      },
      {
        "label": "layer-preview",
        "title": "Layer Preview",
        "url": "/layer-preview",
        "width": 980,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
